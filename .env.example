# Variables leídas por Docker Compose (no por la app) para permitir que cada
# desarrollador use puertos distintos si los de por defecto ya están ocupados
# en su máquina. Si no creás este archivo, se usan los valores por defecto
# (8000, 5173, 5432, 6379).
#
# Para usarlo: copiá este archivo a ".env" (en la raíz del repo, al lado de
# docker-compose.yml) y ajustá los puertos que necesites.

BACKEND_PORT=8000
FRONTEND_PORT=5173
DB_PORT=5432
REDIS_PORT=6379
