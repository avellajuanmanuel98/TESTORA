# Django
SECRET_KEY=change-me-in-every-environment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_LOG_LEVEL=INFO

# Database (docker compose service name is "db")
DATABASE_URL=postgres://assuria:assuria@db:5432/assuria

# Redis / Celery (docker compose service name is "redis")
REDIS_URL=redis://redis:6379/0

# Selenium (docker compose service name is "selenium")
SELENIUM_REMOTE_URL=http://selenium:4444/wd/hub

# CORS: origins allowed to call the API (the Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Default organization every user is attached to until multi-organization
# support ships. Do not change after the first migration/seed unless you
# also migrate existing OrganizationMembership rows.
DEFAULT_ORGANIZATION_SLUG=assuria-internal
DEFAULT_ORGANIZATION_NAME=Assuria Internal

# Fernet key used to encrypt EnvironmentVariable secret values at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
