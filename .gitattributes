# Los scripts que corren dentro de contenedores Linux necesitan finales de
# línea LF sí o sí, sin importar la configuración local de Git de cada
# desarrollador (en Windows, autocrlf suele convertir a CRLF al hacer
# checkout, lo que rompe el shebang del script dentro del contenedor).
*.sh text eol=lf
Dockerfile text eol=lf
